PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/rehema
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_NAME=REHEMA Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-12-character-or-longer-password
API_PUBLIC_URL=http://localhost:5000

# Cloudinary credentials are required for admin image and gallery uploads.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Flutterwave hosted checkout (keep the secret key on the server only).
FLW_SECRET_KEY=FLWSECK_TEST-your-secret-key
FLW_SECRET_HASH=your-webhook-secret-hash
FLW_CURRENCY=UGX
